/* ── 基础类 ── */
.svg-icon {
  display: block;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
}

/* ── 尺寸变体 ── */
.svg-icon--xs  { width: 24rpx;  height: 24rpx;  }
.svg-icon--sm  { width: 30rpx;  height: 30rpx;  }
.svg-icon--md  { width: 40rpx;  height: 40rpx;  }
.svg-icon--lg  { width: 56rpx;  height: 56rpx;  }
.svg-icon--xl  { width: 72rpx;  height: 72rpx;  }
.svg-icon--2xl { width: 88rpx;  height: 88rpx;  }

