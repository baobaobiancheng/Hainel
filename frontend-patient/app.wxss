/* app.wxss - 全局样式系统 */

page {
  /* ── 主色调：深青石绿 ── */
  --c-primary:       #0B9480;
  --c-primary-dark:  #087468;
  --c-primary-mid:   #3DB8AA;
  --c-primary-light: #E0F5F3;
  --c-primary-xlight:#F0FAF9;

  /* ── 强调色：暖珊瑚橙 ── */
  --c-accent:        #FF7B54;
  --c-accent-light:  #FFF0EB;
  --c-accent-dark:   #E5622F;

  /* ── 背景 / 卡片 ── */
  --c-bg:            #F2F6F5;
  --c-card:          #FFFFFF;
  --c-overlay:       rgba(11, 148, 128, 0.06);

  /* ── 文字层级 ── */
  --c-text:          #1A2E35;
  --c-text-2:        #4A6670;
  --c-text-3:        #8AA4AC;
  --c-text-inverse:  #FFFFFF;

  /* ── 分隔线 ── */
  --c-border:        #DCE9E7;
  --c-border-light:  #EEF4F3;

  /* ── 状态色 ── */
  --c-success:       #10B981;
  --c-success-light: #D1FAE5;
  --c-warning:       #F59E0B;
  --c-warning-light: #FEF3C7;
  --c-danger:        #EF4444;
  --c-danger-light:  #FEE2E2;
  --c-pending:       #6366F1;
  --c-pending-light: #EDE9FE;

  /* ── 圆角 ── */
  --r-sm:  12rpx;
  --r-md:  20rpx;
  --r-lg:  28rpx;
  --r-xl:  40rpx;
  --r-2xl: 56rpx;

  /* ── 阴影 ── */
  --shadow-sm: 0 2rpx 12rpx rgba(11, 148, 128, 0.07);
  --shadow-md: 0 4rpx 24rpx rgba(11, 148, 128, 0.11);
  --shadow-lg: 0 8rpx 40rpx rgba(11, 148, 128, 0.16);
  --shadow-card: 0 1rpx 8rpx rgba(26, 46, 53, 0.05), 0 4rpx 16rpx rgba(26, 46, 53, 0.06);

  /* ── 间距 ── */
  --gap-xs:  12rpx;
  --gap-sm:  20rpx;
  --gap-md:  28rpx;
  --gap-lg:  40rpx;
  --gap-xl:  56rpx;

  background-color: var(--c-bg);
  color: var(--c-text);
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

/* ── 通用卡片 ── */
.card {
  background: var(--c-card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

/* ── 通用按钮 ── */
.btn-primary {
  background: var(--c-primary);
  color: var(--c-text-inverse);
  border-radius: var(--r-xl);
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 48rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 20rpx rgba(11, 148, 128, 0.35);
}
.btn-primary::after { border: none; }

.btn-outline {
  background: transparent;
  color: var(--c-primary);
  border: 2rpx solid var(--c-primary);
  border-radius: var(--r-xl);
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 2rpx;
}
.btn-outline::after { border: none; }

.btn-ghost {
  background: var(--c-primary-light);
  color: var(--c-primary);
  border-radius: var(--r-xl);
  font-size: 28rpx;
  font-weight: 500;
  padding: 18rpx 36rpx;
  border: none;
}
.btn-ghost::after { border: none; }

/* ── 标签徽章 ── */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.badge-active   { background: var(--c-success-light); color: var(--c-success); }
.badge-pending  { background: var(--c-pending-light); color: var(--c-pending); }
.badge-completed{ background: var(--c-primary-light); color: var(--c-primary); }
.badge-cancelled{ background: #F3F4F6; color: #9CA3AF; }

/* ── 空状态 ── */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  color: var(--c-text-3);
}
.empty-icon { font-size: 96rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 30rpx; font-weight: 600; margin-bottom: 12rpx; color: var(--c-text-2); }
.empty-desc  { font-size: 26rpx; text-align: center; line-height: 1.6; }

/* ── 分割线 ── */
.divider {
  height: 1rpx;
  background: var(--c-border-light);
  margin: 0 30rpx;
}

/* ── 加载动画 ── */
.loading-dots {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.loading-dots .dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--c-primary);
  animation: dotBounce 1.4s ease-in-out infinite both;
}
.loading-dots .dot:nth-child(1) { animation-delay: -0.32s; }
.loading-dots .dot:nth-child(2) { animation-delay: -0.16s; }
.loading-dots .dot:nth-child(3) { animation-delay: 0s; }

@keyframes dotBounce {
  0%, 80%, 100% { transform: scale(0.8); opacity: 0.5; }
  40%           { transform: scale(1.2); opacity: 1; }
}

/* ── TabBar 底部安全高度（100rpx tabBar + safe-area） ── */
.tab-safe-padding {
  height: calc(100rpx + env(safe-area-inset-bottom));
}

/* ── 淡入动画 ── */
@keyframes fadeSlideUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.animate-in { animation: fadeSlideUp 0.3s ease-out both; }

