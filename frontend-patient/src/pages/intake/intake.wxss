.page {
  min-height: 100vh;
  background: var(--c-bg);
  padding: 32rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.header-card {
  background: linear-gradient(135deg, var(--c-primary), var(--c-primary-dark));
  border-radius: var(--r-lg);
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 28rpx;
  box-shadow: var(--shadow-md);
}

.header-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.82);
  line-height: 1.6;
}

.form-card {
  margin-bottom: 24rpx;
  padding: 0;
}

.form-section-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--c-text-3);
  padding: 24rpx 28rpx 8rpx;
}

.form-item,
.textarea-item {
  padding: 22rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.form-label {
  font-size: 24rpx;
  color: var(--c-text-3);
  font-weight: 600;
}

.form-input,
.picker-value {
  min-height: 52rpx;
  font-size: 30rpx;
  color: var(--c-text);
}

.picker-placeholder {
  color: var(--c-text-3);
}

.form-textarea {
  width: 100%;
  min-height: 88rpx;
  font-size: 28rpx;
  color: var(--c-text);
  line-height: 1.6;
}

.divider {
  height: 1rpx;
  background: var(--c-border-light);
  margin-left: 28rpx;
}

.btn-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.save-btn,
.reset-btn {
  width: 100%;
}
