/* pages/history/history.wxss */

.page {
  background: var(--c-bg);
  min-height: 100vh;
}

/* ── 搜索栏 ── */
.search-bar {
  padding: 20rpx 28rpx;
  background: var(--c-card);
  border-bottom: 1rpx solid var(--c-border-light);
}

.search-input-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--c-bg);
  border-radius: var(--r-xl);
  padding: 16rpx 24rpx;
  border: 2rpx solid var(--c-border);
}

.search-icon { font-size: 28rpx; color: var(--c-text-3); flex-shrink: 0; }

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--c-text);
  height: 48rpx;
}

.search-placeholder { color: var(--c-text-3); }

.search-clear {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--c-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: var(--c-text-2);
  flex-shrink: 0;
}

/* ── 过滤行 ── */
.filter-scroll {
  background: var(--c-card);
  border-bottom: 1rpx solid var(--c-border-light);
}

.filter-row {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 28rpx;
  white-space: nowrap;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  border-radius: var(--r-xl);
  border: 2rpx solid var(--c-border);
  background: var(--c-card);
  flex-shrink: 0;
}

.filter-chip--active {
  background: var(--c-primary);
  border-color: var(--c-primary);
}

.filter-chip--active .filter-chip__icon,
.filter-chip--active .filter-chip__label { color: #FFFFFF; }

.filter-chip__icon  { font-size: 24rpx; }
.filter-chip__label { font-size: 26rpx; color: var(--c-text-2); font-weight: 500; }

.filter-chip__badge {
  background: var(--c-accent);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 100rpx;
  min-width: 28rpx;
  text-align: center;
}

/* ── 会话卡片 ── */
.conv-list {
  padding: 20rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.conv-card {
  background: var(--c-card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.conv-card__top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.conv-card__status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.conv-card__status-dot--active    { background: var(--c-success); box-shadow: 0 0 0 4rpx var(--c-success-light); }
.conv-card__status-dot--pending   { background: var(--c-warning); box-shadow: 0 0 0 4rpx var(--c-warning-light); }
.conv-card__status-dot--completed { background: var(--c-primary-mid); }
.conv-card__status-dot--cancelled { background: #D1D5DB; }

.conv-card__title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--c-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.conv-card__complaint {
  font-size: 26rpx;
  color: var(--c-text-2);
  line-height: 1.5;
  background: var(--c-primary-xlight);
  border-radius: var(--r-md);
  padding: 16rpx 20rpx;
  border-left: 4rpx solid var(--c-primary-mid);
}

.conv-card__meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.conv-card__meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.meta-icon { font-size: 22rpx; }
.meta-text { font-size: 24rpx; color: var(--c-text-3); }

.conv-card__time {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--c-text-3);
}

/* ── 加载更多 ── */
.load-more {
  text-align: center;
  padding: 32rpx;
  font-size: 26rpx;
  color: var(--c-primary);
  font-weight: 500;
}

/* ── 加载行 ── */
.loading-row {
  display: flex;
  justify-content: center;
  padding: 60rpx;
}
