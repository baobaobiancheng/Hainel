/* pages/reminder-form/reminder-form.wxss */

.page {
  background: var(--c-bg);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ── 区域包裹 ── */
.section-wrap {
  padding: 24rpx 28rpx 0;
}

.section-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--c-text-3);
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

/* ── 类型选择 ── */
.type-selector {
  display: flex;
  gap: 16rpx;
}

.type-opt {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 24rpx 12rpx;
  background: var(--c-card);
  border-radius: var(--r-lg);
  border: 2rpx solid var(--c-border);
  box-shadow: var(--shadow-sm);
  transition: all 0.2s;
}

.type-opt--active {
  background: var(--c-primary-light);
  border-color: var(--c-primary);
  box-shadow: 0 4rpx 16rpx rgba(11, 148, 128, 0.2);
}

.type-opt--active .type-opt__label { color: var(--c-primary); font-weight: 700; }

.type-opt__icon  { font-size: 40rpx; }
.type-opt__label { font-size: 24rpx; color: var(--c-text-2); }

/* ── 表单卡片 ── */
.form-card {
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.field-item {
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.field-item--picker {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

/* picker 组件默认 inline，强制撑满行宽 */
picker { display: block; }

.field-item__left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.field-item__icon { font-size: 28rpx; }

.field-item__right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.field-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--c-text);
}

.required { color: var(--c-danger); }

.field-input {
  font-size: 28rpx;
  color: var(--c-text);
  height: 52rpx;
  background: var(--c-bg);
  border-radius: var(--r-md);
  padding: 0 16rpx;
}

.field-textarea {
  font-size: 26rpx;
  color: var(--c-text);
  min-height: 80rpx;
  background: var(--c-bg);
  border-radius: var(--r-md);
  padding: 16rpx;
  line-height: 1.6;
  width: 100%;
  box-sizing: border-box;
}

.field-placeholder { color: var(--c-text-3); }

.picker-val { font-size: 28rpx; color: var(--c-text-3); }
.picker-val--set { color: var(--c-text); font-weight: 500; }
.field-arrow { font-size: 32rpx; color: var(--c-text-3); }

.field-divider {
  height: 1rpx;
  background: var(--c-border-light);
  margin: 0 28rpx;
}

/* ── 频率选择 ── */
.freq-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.freq-chip {
  padding: 16rpx 28rpx;
  border-radius: var(--r-xl);
  font-size: 26rpx;
  font-weight: 500;
  background: var(--c-card);
  color: var(--c-text-2);
  border: 2rpx solid var(--c-border);
  box-shadow: var(--shadow-sm);
}

.freq-chip--active {
  background: var(--c-primary);
  color: #FFFFFF;
  border-color: var(--c-primary);
  box-shadow: 0 4rpx 12rpx rgba(11, 148, 128, 0.3);
}

/* 周日选择器 */
.weekday-picker {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.weekday-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: var(--r-md);
  font-size: 24rpx;
  font-weight: 600;
  color: var(--c-text-2);
  background: var(--c-card);
  border: 2rpx solid var(--c-border);
}

.weekday-btn--active {
  background: var(--c-primary-light);
  color: var(--c-primary);
  border-color: var(--c-primary);
}

/* ── 错误提示 ── */
.error-tip {
  margin: 16rpx 28rpx 0;
  background: var(--c-danger-light);
  border-radius: var(--r-md);
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: var(--c-danger);
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* ── 提交区 ── */
.submit-area {
  padding: 32rpx 28rpx 0;
  display: flex;
  gap: 20rpx;
}

.cancel-btn {
  flex: 1;
  font-size: 28rpx;
  padding: 26rpx;
  border-color: var(--c-danger) !important;
  color: var(--c-danger) !important;
}

.cancel-btn::after { border: none; }

.save-btn {
  flex: 2;
  font-size: 32rpx;
  padding: 26rpx;
  letter-spacing: 2rpx;
}
