/* pages/profile/profile.wxss */

.page {
  background: var(--c-bg);
  min-height: 100vh;
}

/* ── 英雄区 ── */
.hero {
  background: linear-gradient(145deg, var(--c-primary) 0%, var(--c-primary-dark) 100%);
  padding: 48rpx 32rpx 0;
  border-radius: 0 0 48rpx 48rpx;
  overflow: hidden;
  position: relative;
  box-shadow: var(--shadow-md);
}

.hero-bg {
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.06);
  pointer-events: none;
}

.hero-inner {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding-bottom: 36rpx;
}

.avatar-ring {
  padding: 4rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255,255,255,0.5);
  flex-shrink: 0;
  position: relative;
}

.avatar-circle {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-char {
  font-size: 44rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.avatar-edit {
  position: absolute;
  right: -10rpx;
  bottom: -8rpx;
  min-width: 52rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.78);
  color: #FFFFFF;
  font-size: 18rpx;
  line-height: 30rpx;
  text-align: center;
  border: 2rpx solid rgba(255,255,255,0.7);
}

.hero-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.hero-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.hero-meta {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

/* 统计行 */
.stats-row {
  display: flex;
  background: rgba(255,255,255,0.12);
  border-radius: 20rpx 20rpx 0 0;
  padding: 24rpx 16rpx;
}

.stat-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.65);
  margin-top: 4rpx;
}

.stat-sep {
  width: 1rpx;
  background: rgba(255,255,255,0.2);
  margin: 8rpx 0;
}

/* ── 菜单区 ── */
.menu-section {
  margin: 28rpx 28rpx 0;
}

.menu-section__label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--c-text-3);
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

.menu-group {
  border-radius: var(--r-lg);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 24rpx;
  background: var(--c-card);
  border-bottom: 1rpx solid var(--c-border-light);
}

.menu-item:last-child { border-bottom: none; }

.menu-item__icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-item__icon { font-size: 32rpx; }

.menu-item__title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--c-text);
}

.menu-item__right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.menu-item__badge {
  background: var(--c-accent);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 100rpx;
}

.menu-item__arrow {
  font-size: 32rpx;
  color: var(--c-text-3);
}

/* ── 退出 ── */
.logout-wrap {
  margin: 28rpx 28rpx 0;
}

.logout-btn {
  width: 100%;
  background: #FEE2E2;
  color: var(--c-danger);
  border-radius: var(--r-xl);
  font-size: 28rpx;
  font-weight: 600;
  padding: 26rpx;
  border: none;
}
.logout-btn::after { border: none; }

/* ── 未登录 ── */
.not-login {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.not-login__icon {
  font-size: 100rpx;
  margin-bottom: 28rpx;
}

.not-login__title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 16rpx;
}

.not-login__desc {
  font-size: 28rpx;
  color: var(--c-text-2);
  text-align: center;
  line-height: 1.6;
}
