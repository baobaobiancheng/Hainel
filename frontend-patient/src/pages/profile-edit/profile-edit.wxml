<!--pages/profile-edit/profile-edit.wxml-->
<view class="page">

  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-dots">
      <view class="dot"></view>
      <view class="dot"></view>
      <view class="dot"></view>
    </view>
  </view>

  <block wx:else>
    <!-- 顶部提示 -->
    <view class="header-tip">
      <view class="svg-icon svg-icon--sm svg-icon--user header-tip__icon"></view>
      <text class="header-tip__text">修改后将同步更新您的账号信息</text>
    </view>

    <!-- 表单卡片 -->
    <view class="form-card card">

      <!-- 姓名 -->
      <view class="form-section-label">基本信息</view>

      <view class="form-item">
        <view class="form-item__icon-wrap">
          <view class="svg-icon svg-icon--sm svg-icon--edit form-item__icon"></view>
        </view>
        <view class="form-item__content">
          <text class="form-item__label">姓名</text>
          <input
            class="form-item__input"
            placeholder="请填写真实姓名"
            placeholder-class="form-placeholder"
            value="{{form.full_name}}"
            bindinput="onInput"
            data-field="full_name"
            confirm-type="next"
          />
        </view>
      </view>

      <view class="divider"></view>

      <!-- 手机号 -->
      <view class="form-item">
        <view class="form-item__icon-wrap">
          <view class="svg-icon svg-icon--sm svg-icon--phone form-item__icon"></view>
        </view>
        <view class="form-item__content">
          <text class="form-item__label">手机号</text>
          <input
            class="form-item__input"
            placeholder="请填写手机号码"
            placeholder-class="form-placeholder"
            value="{{form.phone}}"
            bindinput="onInput"
            data-field="phone"
            type="number"
            confirm-type="next"
          />
        </view>
      </view>

      <view class="divider"></view>

      <!-- 邮箱 -->
      <view class="form-item">
        <view class="form-item__icon-wrap">
          <view class="svg-icon svg-icon--sm svg-icon--mail form-item__icon"></view>
        </view>
        <view class="form-item__content">
          <text class="form-item__label">邮箱</text>
          <input
            class="form-item__input"
            placeholder="请填写邮箱地址（选填）"
            placeholder-class="form-placeholder"
            value="{{form.email}}"
            bindinput="onInput"
            data-field="email"
            type="text"
            confirm-type="done"
          />
        </view>
      </view>
    </view>

    <!-- 错误提示 -->
    <view class="form-error" wx:if="{{errorMsg}}">
      <view class="svg-icon svg-icon--sm svg-icon--warning form-error__icon"></view>
      <text class="form-error__text">{{errorMsg}}</text>
    </view>

    <!-- 操作按钮 -->
    <view class="btn-group">
      <button class="btn-primary save-btn" bindtap="save" disabled="{{saving}}">
        <text wx:if="{{!saving}}">保存修改</text>
        <view class="loading-dots" wx:else>
          <view class="dot dot--white"></view>
          <view class="dot dot--white"></view>
          <view class="dot dot--white"></view>
        </view>
      </button>
      <button class="btn-outline reset-btn" bindtap="reset">
        恢复原始
      </button>
    </view>
  </block>

</view>
