/* pages/profile-edit/profile-edit.wxss */

.page {
  min-height: 100vh;
  background: var(--c-bg);
  padding: 32rpx 32rpx 60rpx;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding-top: 200rpx;
}

/* 顶部提示 */
.header-tip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--c-primary-xlight);
  border: 1rpx solid var(--c-border);
  border-radius: var(--r-lg);
  padding: 24rpx 28rpx;
  margin-bottom: 28rpx;
}

.header-tip__icon { font-size: 32rpx; }

.header-tip__text {
  font-size: 26rpx;
  color: var(--c-primary-dark);
  line-height: 1.5;
}

/* 表单卡片 */
.form-card {
  padding: 0;
  margin-bottom: 24rpx;
}

.form-section-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--c-text-3);
  letter-spacing: 1rpx;
  padding: 24rpx 28rpx 12rpx;
  text-transform: uppercase;
}

/* 表单项 */
.form-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 28rpx;
}

.form-item__icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--c-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.form-item__icon { font-size: 30rpx; }

.form-item__content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.form-item__label {
  font-size: 22rpx;
  color: var(--c-text-3);
  font-weight: 500;
}

.form-item__input {
  font-size: 30rpx;
  color: var(--c-text);
  height: 52rpx;
  background: transparent;
}

.form-placeholder {
  color: var(--c-text-3);
  font-size: 28rpx;
}

/* 错误提示 */
.form-error {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--c-danger-light);
  border-radius: var(--r-md);
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.form-error__icon { font-size: 28rpx; }
.form-error__text { font-size: 26rpx; color: var(--c-danger); }

/* 按钮组 */
.btn-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.save-btn {
  width: 100%;
  padding: 28rpx;
  font-size: 32rpx;
  letter-spacing: 4rpx;
}

.reset-btn {
  width: 100%;
  padding: 24rpx;
  font-size: 30rpx;
}

.dot--white { background: #FFFFFF; }
