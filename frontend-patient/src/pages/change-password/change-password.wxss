/* pages/change-password/change-password.wxss */

.page {
  min-height: 100vh;
  background: var(--c-bg);
  padding: 32rpx 32rpx 60rpx;
}

/* 顶部安全提示 */
.header-tip {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background: var(--c-warning-light);
  border: 1rpx solid #FDE68A;
  border-radius: var(--r-lg);
  padding: 24rpx 28rpx;
  margin-bottom: 28rpx;
}

.header-tip__icon { font-size: 32rpx; flex-shrink: 0; }

.header-tip__text {
  font-size: 26rpx;
  color: #92400E;
  line-height: 1.6;
}

/* 表单卡片 */
.form-card {
  padding: 0;
  margin-bottom: 24rpx;
}

.form-section-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--c-text-3);
  letter-spacing: 1rpx;
  padding: 24rpx 28rpx 12rpx;
}

/* 表单项 */
.form-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 28rpx;
}

.form-item__icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.form-item__icon { font-size: 30rpx; }

.form-item__content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.form-item__label {
  font-size: 22rpx;
  color: var(--c-text-3);
  font-weight: 500;
}

.form-item__input {
  font-size: 30rpx;
  color: var(--c-text);
  height: 52rpx;
  background: transparent;
}

.form-placeholder {
  color: var(--c-text-3);
  font-size: 28rpx;
}

.eye-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

/* 密码强度 */
.strength-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 28rpx 20rpx;
}

.strength-label {
  font-size: 24rpx;
  color: var(--c-text-3);
}

.strength-bars {
  display: flex;
  gap: 8rpx;
}

.strength-bar {
  width: 48rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--c-border);
  transition: background 0.2s;
}

.strength-bar--weak   { background: var(--c-danger); }
.strength-bar--medium { background: var(--c-warning); }
.strength-bar--strong { background: var(--c-success); }

.strength-text { font-size: 22rpx; font-weight: 600; }
.strength-text--bad    { color: var(--c-danger); }
.strength-text--weak   { color: var(--c-danger); }
.strength-text--medium { color: var(--c-warning); }
.strength-text--strong { color: var(--c-success); }

/* 错误提示 */
.form-error {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--c-danger-light);
  border-radius: var(--r-md);
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.form-error__icon { font-size: 28rpx; }
.form-error__text { font-size: 26rpx; color: var(--c-danger); }

/* 成功提示 */
.form-success {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--c-success-light);
  border-radius: var(--r-md);
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.form-success__icon { font-size: 28rpx; }
.form-success__text { font-size: 26rpx; color: var(--c-success); font-weight: 600; }

/* 提交按钮 */
.save-btn {
  width: 100%;
  padding: 28rpx;
  font-size: 32rpx;
  letter-spacing: 4rpx;
}

.dot--white { background: #FFFFFF; }
