<!--pages/change-password/change-password.wxml-->
<view class="page">

  <!-- 顶部安全提示 -->
  <view class="header-tip">
    <view class="svg-icon svg-icon--sm svg-icon--lock header-tip__icon"></view>
    <text class="header-tip__text">建议使用包含字母和数字的组合密码，长度至少6位</text>
  </view>

  <!-- 表单卡片 -->
  <view class="form-card card">

    <view class="form-section-label">密码设置</view>

    <!-- 当前密码 -->
    <view class="form-item">
      <view class="form-item__icon-wrap" style="background: #FEF3C7;">
        <view class="svg-icon svg-icon--sm svg-icon--key form-item__icon"></view>
      </view>
      <view class="form-item__content">
        <text class="form-item__label">当前密码</text>
        <input
          class="form-item__input"
          placeholder="请输入当前密码"
          placeholder-class="form-placeholder"
          value="{{form.old_password}}"
          bindinput="onInput"
          data-field="old_password"
          password="{{!showOld}}"
          confirm-type="next"
        />
      </view>
      <view class="eye-btn" bindtap="toggleShow" data-field="showOld">
        <view wx:if="{{showOld}}" class="svg-icon svg-icon--sm svg-icon--eye-off"></view>
        <view wx:else class="svg-icon svg-icon--sm svg-icon--eye"></view>
      </view>
    </view>

    <view class="divider"></view>

    <!-- 新密码 -->
    <view class="form-item">
      <view class="form-item__icon-wrap" style="background: var(--c-primary-light);">
        <view class="svg-icon svg-icon--sm svg-icon--lock form-item__icon"></view>
      </view>
      <view class="form-item__content">
        <text class="form-item__label">新密码</text>
        <input
          class="form-item__input"
          placeholder="请输入新密码（至少6位）"
          placeholder-class="form-placeholder"
          value="{{form.new_password}}"
          bindinput="onInput"
          data-field="new_password"
          password="{{!showNew}}"
          confirm-type="next"
        />
      </view>
      <view class="eye-btn" bindtap="toggleShow" data-field="showNew">
        <view wx:if="{{showNew}}" class="svg-icon svg-icon--sm svg-icon--eye-off"></view>
        <view wx:else class="svg-icon svg-icon--sm svg-icon--eye"></view>
      </view>
    </view>

    <view class="divider"></view>

    <!-- 确认新密码 -->
    <view class="form-item">
      <view class="form-item__icon-wrap" style="background: var(--c-primary-light);">
        <view class="svg-icon svg-icon--sm svg-icon--check-circle form-item__icon"></view>
      </view>
      <view class="form-item__content">
        <text class="form-item__label">确认新密码</text>
        <input
          class="form-item__input"
          placeholder="再次输入新密码"
          placeholder-class="form-placeholder"
          value="{{form.confirm_password}}"
          bindinput="onInput"
          data-field="confirm_password"
          password="{{!showConfirm}}"
          confirm-type="done"
          bindconfirm="save"
        />
      </view>
      <view class="eye-btn" bindtap="toggleShow" data-field="showConfirm">
        <view wx:if="{{showConfirm}}" class="svg-icon svg-icon--sm svg-icon--eye-off"></view>
        <view wx:else class="svg-icon svg-icon--sm svg-icon--eye"></view>
      </view>
    </view>

    <!-- 密码强度条（根据新密码长度显示） -->
    <view class="strength-wrap" wx:if="{{form.new_password}}">
      <text class="strength-label">密码强度：</text>
      <view class="strength-bars">
        <view class="strength-bar {{form.new_password.length >= 6 ? 'strength-bar--weak' : ''}}"></view>
        <view class="strength-bar {{form.new_password.length >= 8 ? 'strength-bar--medium' : ''}}"></view>
        <view class="strength-bar {{form.new_password.length >= 10 ? 'strength-bar--strong' : ''}}"></view>
      </view>
      <text class="strength-text strength-text--{{form.new_password.length < 6 ? 'bad' : form.new_password.length < 8 ? 'weak' : form.new_password.length < 10 ? 'medium' : 'strong'}}">
        {{form.new_password.length < 6 ? '太短' : form.new_password.length < 8 ? '弱' : form.new_password.length < 10 ? '中' : '强'}}
      </text>
    </view>

  </view>

  <!-- 错误提示 -->
  <view class="form-error" wx:if="{{errorMsg}}">
    <view class="svg-icon svg-icon--sm svg-icon--warning form-error__icon"></view>
    <text class="form-error__text">{{errorMsg}}</text>
  </view>

  <!-- 成功提示 -->
  <view class="form-success" wx:if="{{successMsg}}">
    <view class="svg-icon svg-icon--sm svg-icon--check-circle form-success__icon"></view>
    <text class="form-success__text">{{successMsg}}</text>
  </view>

  <!-- 提交按钮 -->
  <button class="btn-primary save-btn" bindtap="save" disabled="{{saving}}">
    <text wx:if="{{!saving}}">确认修改密码</text>
    <view class="loading-dots" wx:else>
      <view class="dot dot--white"></view>
      <view class="dot dot--white"></view>
      <view class="dot dot--white"></view>
    </view>
  </button>

</view>
