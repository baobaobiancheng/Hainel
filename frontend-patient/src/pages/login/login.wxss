/* pages/login/login.wxss */

.page {
  background: linear-gradient(160deg, var(--c-primary) 0%, var(--c-primary-dark) 40%, var(--c-bg) 40%);
  min-height: 100vh;
  padding: 0 40rpx 60rpx;
  display: flex;
  flex-direction: column;
}

/* ── 品牌区 ── */
.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 60rpx;
}

.brand-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 36rpx;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  border: 3rpx solid rgba(255,255,255,0.3);
  backdrop-filter: blur(8px);
}

.brand-logo__icon { font-size: 64rpx; }

.brand-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.brand-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.75);
  letter-spacing: 4rpx;
}

/* ── 模式切换 ── */
.mode-switch {
  display: flex;
  background: rgba(255,255,255,0.15);
  border-radius: var(--r-xl);
  padding: 6rpx;
  margin-bottom: 28rpx;
  position: relative;
  border: 1rpx solid rgba(255,255,255,0.25);
  backdrop-filter: blur(12px);
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.7);
  z-index: 1;
  transition: color 0.25s;
}

.mode-tab--active { color: var(--c-primary); }

.mode-indicator {
  position: absolute;
  top: 6rpx;
  bottom: 6rpx;
  width: calc(50% - 8rpx);
  background: #FFFFFF;
  border-radius: 100rpx;
  transition: left 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 2rpx 12rpx rgba(11, 148, 128, 0.2);
}

/* ── 表单卡片 ── */
.form-card {
  border-radius: var(--r-xl);
  padding: 36rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  animation: fadeSlideUp 0.35s ease-out both;
}

/* 表单项 */
.form-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--c-bg);
  border-radius: var(--r-lg);
  padding: 8rpx 16rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}

.form-item__icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--c-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.form-item__icon { font-size: 28rpx; }

.form-item__input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: var(--c-text);
  background: transparent;
}

.form-placeholder { color: var(--c-text-3); font-size: 28rpx; }

.form-item__eye {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

/* 错误提示 */
.form-error {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--c-danger-light);
  border-radius: var(--r-md);
  padding: 16rpx 20rpx;
}

.form-error__icon { font-size: 26rpx; }
.form-error__text { font-size: 26rpx; color: var(--c-danger); }

/* 提交按钮 */
.submit-btn {
  width: 100%;
  margin-top: 8rpx;
  padding: 28rpx;
  font-size: 32rpx;
  letter-spacing: 4rpx;
}

/* ── 协议 ── */
.agreement {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 32rpx;
  gap: 4rpx;
}

.agreement-text {
  font-size: 22rpx;
  color: var(--c-text-3);
}

.agreement-link {
  font-size: 22rpx;
  color: var(--c-primary);
}
