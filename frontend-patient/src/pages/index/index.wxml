<!--pages/index/index.wxml-->
<view class="page">

  <!-- ── 顶部英雄横幅 ── -->
  <view class="hero">
    <view class="hero-bg-shape"></view>
    <view class="hero-content">
      <view class="hero-left">
        <text class="hero-greeting">{{greeting}}，</text>
        <text class="hero-name">{{userInfo.full_name || userInfo.username || '朋友'}} 👋</text>
        <text class="hero-sub">您的健康，我们守护</text>
      </view>
      <view class="hero-avatar" bindtap="goToProfile">
        <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill"></image>
        <text wx:else class="avatar-char">{{avatarChar}}</text>
      </view>
    </view>

    <!-- 健康数据快览 -->
    <view class="health-stats">
      <view class="stat-item">
        <text class="stat-num">{{stats.conversations}}</text>
        <text class="stat-label">咨询次数</text>
      </view>
      <view class="stat-sep"></view>
      <view class="stat-item">
        <text class="stat-num">{{stats.reminders}}</text>
        <text class="stat-label">今日提醒</text>
      </view>
      <view class="stat-sep"></view>
      <view class="stat-item">
        <text class="stat-num">{{stats.reports}}</text>
        <text class="stat-label">上传报告</text>
      </view>
    </view>
  </view>

  <!-- ── 快捷操作 ── -->
  <view class="section-wrap">

    <!-- 主功能：智能咨询（全宽横向卡） -->
    <view class="qc-feat" bindtap="startNewConsultation">
      <view class="qc-feat__icon-box">
        <view class="qc-feat__svg"></view>
      </view>
      <view class="qc-feat__body">
        <text class="qc-feat__title">智能咨询</text>
        <text class="qc-feat__desc">多智能体协同，专业辅助诊断</text>
      </view>
      <text class="qc-feat__arrow">›</text>
    </view>

  </view>

  <!-- ── 最近咨询 ── -->
  <view class="section-wrap">
    <view class="section-hd">
      <text class="section-title">最近咨询</text>
      <text class="section-more" bindtap="viewHistory">查看全部 ›</text>
    </view>

    <view class="conv-list" wx:if="{{recentConversations.length > 0}}">
      <view
        class="conv-item animate-in"
        wx:for="{{recentConversations}}"
        wx:key="id"
        bindtap="viewConversation"
        data-id="{{item.id}}"
        style="animation-delay: {{index * 0.06}}s"
      >
        <view class="conv-dot conv-dot--{{item.status}}"></view>
        <view class="conv-body">
          <text class="conv-title">{{item.title || '健康咨询'}}</text>
          <text class="conv-preview">{{item.chief_complaint || '点击查看详情'}}</text>
        </view>
        <view class="conv-right">
          <view class="badge badge-{{item.status}}">
            <text wx:if="{{item.status === 'active'}}">进行中</text>
            <text wx:if="{{item.status === 'pending'}}">等待中</text>
            <text wx:if="{{item.status === 'completed'}}">已完成</text>
          </view>
          <text class="conv-time">{{item.relativeTime}}</text>
        </view>
      </view>
    </view>

    <view class="empty-wrap" wx:else>
      <text class="empty-icon">🩺</text>
      <text class="empty-title">还没有咨询记录</text>
      <text class="empty-desc">描述您的症状，智能体将为您提供专业建议</text>
      <button class="btn-primary start-btn" bindtap="startNewConsultation">立即咨询</button>
    </view>
  </view>

  <!-- ── 健康小贴士 ── -->
  <view class="section-wrap">
    <view class="tip-card">
      <view class="tip-icon">💡</view>
      <view class="tip-body">
        <text class="tip-title">健康提示</text>
        <text class="tip-content">{{healthTip}}</text>
      </view>
    </view>
  </view>

  <view class="tab-safe-padding"></view>

</view>
