<!--components/FileUploader/FileUploader.wxml-->
<view class="file-uploader">
  <!-- 文件列表 -->
  <view class="file-list" wx:if="{{files.length > 0}}">
    <view 
      class="file-item"
      wx:for="{{files}}"
      wx:key="path"
      data-index="{{index}}"
    >
      <view class="file-preview" bindtap="previewFile" data-index="{{index}}">
        <image 
          wx:if="{{item.isImage}}"
          class="file-image"
          src="{{item.path}}"
          mode="aspectFill"
        />
        <view class="file-icon" wx:else>
          <text>📄</text>
        </view>
        <view class="file-overlay" wx:if="{{item.status === 'uploading'}}">
          <text class="progress-text">{{item.progress}}%</text>
        </view>
        <view class="file-overlay error" wx:if="{{item.status === 'error'}}">
          <text>✕</text>
        </view>
      </view>
      <view class="file-actions">
        <view class="delete-btn" bindtap="deleteFile" data-index="{{index}}">
          <text>删除</text>
        </view>
      </view>
      <!-- 进度条 -->
      <view class="progress-bar" wx:if="{{item.status === 'uploading'}}">
        <view class="progress-fill" style="width: {{item.progress}}%"></view>
      </view>
    </view>
  </view>

  <!-- 添加按钮 -->
  <view 
    class="add-button {{files.length >= maxCount ? 'disabled' : ''}}"
    bindtap="chooseFile"
    wx:if="{{files.length < maxCount && !disabled}}"
  >
    <text class="add-icon">+</text>
    <text class="add-text">添加文件</text>
  </view>
</view>

