/* components/ChatBubble/ChatBubble.wxss */
.chat-bubble {
  display: flex;
  margin-bottom: 30rpx;
  animation: fadeIn 0.3s;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.bubble-user {
  justify-content: flex-end;
}

.bubble-assistant {
  justify-content: flex-start;
}

.bubble-content {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  position: relative;
}

.bubble-user .bubble-content {
  background: #4A90E2;
  color: white;
  border-bottom-right-radius: 4rpx;
}

.bubble-assistant .bubble-content {
  background: white;
  color: #333;
  border-bottom-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.bubble-text {
  font-size: 28rpx;
  line-height: 1.6;
  word-wrap: break-word;
}

.bubble-time {
  font-size: 20rpx;
  margin-top: 10rpx;
  opacity: 0.7;
  display: block;
}

